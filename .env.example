# Groq API Key — get yours at https://console.groq.com (free, no card required)
GROQ_API_KEY=your_groq_api_key_here

# Database URL
# For local development: SQLite (default, no setup needed)
DATABASE_URL=sqlite:///./bookkeeping.db

# For production (e.g. Neon / Supabase Postgres):
# DATABASE_URL=postgresql://user:password@host:5432/dbname
